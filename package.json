{
  "name": "pixivdownloader-web-tests",
  "private": true,
  "scripts": {
    "test:js": "node --test \"pixivdownload-*/src/test/js/*.test.js\" \"plugin-templates/*/src/test/js/*.test.js\" \"scripts/ci/test/*.test.mjs\"",
    "test:web-standards": "node scripts/check-web-standards.mjs",
    "sdk:version": "node scripts/ci/sdk-version.mjs --repo-root .",
    "sdk:surface": "node scripts/ci/sdk-api-surface.mjs",
    "sdk:release": "node scripts/ci/sdk-release.mjs",
    "test:i18n": "node --test \"scripts/i18n/test/*.test.mjs\"",
    "i18n:check": "node scripts/i18n/check.mjs --strict",
    "i18n:report": "node scripts/i18n/check.mjs --report-only",
    "i18n:prompt": "node scripts/i18n/check.mjs --strict --write-agent-prompts",
    "i18n:accept": "node scripts/i18n/accept.mjs",
    "i18n:lock:prune": "node scripts/i18n/accept.mjs --prune",
    "i18n:generate-static": "node scripts/i18n/generate-static.mjs",
    "gate:trust": "node scripts/ci/trust-gate.mjs",
    "gate:contract": "node scripts/ci/gate-contract.mjs",
    "gate:parity": "node scripts/ci/gate-contract.mjs --candidate-snapshot worktree",
    "gate:signature": "node scripts/ci/gate-contract.mjs --candidate-snapshot worktree --signature",
    "i18n:trust-gate": "node scripts/ci/trust-gate.mjs",
    "i18n:gate-contract": "node scripts/ci/gate-contract.mjs",
    "i18n:gate-parity": "npm run gate:parity",
    "i18n:gate-signature": "npm run gate:signature",
    "setup:hooks": "node scripts/i18n/install-hooks.mjs",
    "doctor:hooks": "node scripts/i18n/doctor-hooks.mjs",
    "doctor:github-gate": "node scripts/ci/doctor-github-ruleset.mjs"
  },
  "devDependencies": {
    "yaml": "^2.5.1"
  }
}
