{
  "name": "pixivdownloader-web-tests",
  "private": true,
  "scripts": {
    "test:js": "node --test \"pixivdownload-*/src/test/js/*.test.js\" \"plugin-templates/*/src/test/js/*.test.js\"",
    "test:web-standards": "node scripts/check-web-standards.mjs",
    "test:i18n": "node --test \"scripts/i18n/test/*.test.mjs\"",
    "i18n:check": "node scripts/i18n/check.mjs --strict",
    "i18n:report": "node scripts/i18n/check.mjs --report-only",
    "i18n:prompt": "node scripts/i18n/check.mjs --strict --write-agent-prompts",
    "i18n:accept": "node scripts/i18n/accept.mjs",
    "i18n:lock:prune": "node scripts/i18n/accept.mjs --prune",
    "i18n:generate-static": "node scripts/i18n/generate-static.mjs",
    "i18n:trust-gate": "node scripts/i18n/trust-gate.mjs",
    "i18n:gate-contract": "node scripts/i18n/gate-contract.mjs",
    "i18n:gate-parity": "node -e \"const{execSync,spawnSync}=require('child_process');const sha=execSync('git rev-parse HEAD').toString().trim();const r=spawnSync(process.execPath,['scripts/ci/gate-parity.mjs','--repo-root','.','--candidate-ref',sha,'--invariants'],{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
    "i18n:gate-signature": "node -e \"const{execSync,spawnSync}=require('child_process');const sha=execSync('git rev-parse HEAD').toString().trim();const r=spawnSync(process.execPath,['scripts/ci/gate-parity.mjs','--repo-root','.','--candidate-ref',sha,'--invariants','--signature'],{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
    "setup:hooks": "node scripts/i18n/install-hooks.mjs",
    "doctor:hooks": "node scripts/i18n/doctor-hooks.mjs",
    "doctor:github-gate": "node scripts/ci/doctor-github-ruleset.mjs"
  },
  "devDependencies": {
    "yaml": "^2.5.1"
  }
}
