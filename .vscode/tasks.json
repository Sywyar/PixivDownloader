{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AOT Prepare",
      "type": "process",
      "command": "${workspaceFolder}/mvnw",
      "windows": { "command": "${workspaceFolder}\\mvnw.cmd" },
      "args": ["-N", "-Paot", "-Daot.command=prepare", "validate"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "AOT Packaged Run",
      "type": "process",
      "command": "${workspaceFolder}/mvnw",
      "windows": { "command": "${workspaceFolder}\\mvnw.cmd" },
      "args": ["-N", "-Paot", "validate"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Compile Developer Runtime",
      "type": "process",
      "command": "${workspaceFolder}/mvnw",
      "windows": {
        "command": "${workspaceFolder}\\mvnw.cmd"
      },
      "args": [
        "-pl",
        "pixivdownload-app,pixivdownload-official-plugins",
        "-am",
        "process-classes",
        "-Dexec.skip=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Compile Application",
      "type": "process",
      "command": "${workspaceFolder}/mvnw",
      "windows": {
        "command": "${workspaceFolder}\\mvnw.cmd"
      },
      "args": [
        "-pl",
        "pixivdownload-app",
        "-am",
        "compile",
        "-Dexec.skip=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Compile Recovery Runtime",
      "type": "process",
      "command": "${workspaceFolder}/mvnw",
      "windows": {
        "command": "${workspaceFolder}\\mvnw.cmd"
      },
      "args": [
        "-pl",
        "pixivdownload-app,pixivdownload-official-plugins",
        "-am",
        "-Precovery-mode",
        "process-classes",
        "-Dexec.skip=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
