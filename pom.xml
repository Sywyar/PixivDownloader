<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         child.project.url.inherit.append.path="false"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>top.sywyar.lovepopup</groupId>
    <artifactId>pixivdownload-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>PixivDownloader Parent</name>
    <description>PixivDownloader 多模块聚合父工程（核心壳、共享运行时与官方外置插件）</description>
    <url>https://github.com/Sywyar/PixivDownloader</url>
    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>Sywyar</id>
            <name>Sywyar</name>
            <email>sywyari@163.com</email>
            <url>https://github.com/Sywyar</url>
        </developer>
    </developers>
    <modules>
        <!-- SDK 版本与兼容规则的唯一事实源；纯 JDK，独立于应用发行版本。 -->
        <module>pixivdownload-sdk-info</module>
        <!-- 跨插件契约模块先构建（主程序依赖之），零业务依赖由编译期强制；产物仍打进主程序的单一 boot jar -->
        <module>pixivdownload-plugin-api</module>
        <!-- 核心 owned 语义端口 + 结果 DTO（core.stats.*），Spring-free 纯 JDK；主程序依赖之，产物打进 boot jar -->
        <module>pixivdownload-core-api</module>
        <!-- 第三方插件统一导入的 SDK 依赖版本清单；不进入运行时。 -->
        <module>pixivdownload-sdk-bom</module>
        <!-- 宿主 owned 插件供应链验签模块，Spring-free / PF4J-free / app-free / plugin-runtime-free，纯 JDK 17 -->
        <module>pixivdownload-plugin-signature</module>
        <!-- 最小 PF4J 执行内核与隔离 worker；独立可执行产物只携带协议、稳定契约和 PF4J，不继承 app classpath。 -->
        <module>pixivdownload-plugin-worker</module>
        <!-- 插件框架的 Spring 耦合启用运行时（三件套），各功能插件模块编译期依赖之；产物打进 boot jar -->
        <module>pixivdownload-plugin-runtime</module>
        <!-- 官方 GUI 主题外置插件（startup-only），打成 PF4J 插件 jar：根 plugin.properties + 插件类 / 资源 +
             lib/*.jar 私有依赖。FlatLaf / IntelliJ Themes / JNA / JNA Platform 只随该 jar 分发，不进入 app boot jar。 -->
        <module>pixivdownload-plugin-gui-swing</module>
        <!-- 可选 Compose Multiplatform 桌面提供者；Gradle 是唯一编译与产物来源，Maven 仅适配 reactor 生命周期。 -->
        <module>pixivdownload-plugin-gui-compose</module>
        <!-- 画廊工具插件：统计与疑似重复共享单一 thin PF4J 插件包和生命周期。 -->
        <module>pixivdownload-plugin-gallery-tools</module>
        <module>pixivdownload-plugin-notification</module>
        <module>pixivdownload-plugin-push</module>
        <module>pixivdownload-plugin-mail</module>
        <module>pixivdownload-plugin-tts</module>
        <module>pixivdownload-plugin-ai</module>
        <!-- Douyin 第三方兼容性插件源码；保留同一模块与插件 ID，不纳入官方插件发布聚合。 -->
        <module>pixivdownload-plugin-douyin</module>
        <!-- 最小外置插件（id=recovery-sentinel），只依赖 plugin-api / PF4J（均 provided），不贡献任何功能；打成 thin 外置
             PF4J 插件 jar，放入 plugins/ 由运行时加载——不进 boot jar、app 不依赖。声明在 app 之前，使其 target/classes 在
             app 测试期已就绪，供恢复模式端到端集成测试组装临时插件 jar 做真实加载验证 -->
        <module>pixivdownload-plugin-recovery-sentinel</module>
        <!-- 官方必需下载工作台外置插件。app 不依赖本模块；默认发行包把该 jar 放入 plugins/ 由 PF4J 加载。 -->
        <module>pixivdownload-plugin-download-workbench</module>
        <!-- 官方 PostHog 调查适配插件：提供 vendored SDK，并按调用方 owner key 与参数创建隔离命名客户端。 -->
        <module>pixivdownload-plugin-posthog</module>
        <!-- 官方多人模式去留调查：仅通过管理员站内信展示，自持 PostHog 参数与调查语义。 -->
        <module>pixivdownload-plugin-multi-mode-decision-survey</module>
        <!-- 官方可选本地画廊外置插件。核心下载事实 / 元数据 / 资产能力留 app，本模块只承载展示层。 -->
        <module>pixivdownload-plugin-gallery</module>
        <!-- 官方可选小说外置插件。核心 schema 留 app，本模块承载小说下载、翻译、合订、朗读协作与展示层。 -->
        <module>pixivdownload-plugin-novel</module>
        <!-- 核心壳在全部官方外置插件之后构建，使完整 reactor 的 app 集成测试消费本轮已构建的插件 classes。 -->
        <module>pixivdownload-app</module>
        <!-- 官方外置插件开发构建聚合入口。IDE 可用 -pl pixivdownload-official-plugins -am compile 一次性编译全部外置插件。 -->
        <module>pixivdownload-official-plugins</module>
    </modules>
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/Sywyar/PixivDownloader.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Sywyar/PixivDownloader.git</developerConnection>
        <tag>${pixivdownload.source.sha}</tag>
        <url>https://github.com/Sywyar/PixivDownloader</url>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/Sywyar/PixivDownloader/issues</url>
    </issueManagement>
    <properties>
        <java.version>17</java.version>
        <app.release.version>${project.version}</app.release.version>
        <!-- sdk-info 资源是 SDK 身份事实源；revision 只是 Maven CI-friendly 版本投影名。 -->
        <revision>1.0.0-rc2</revision>
        <pixivdownload.sdk.version>${revision}</pixivdownload.sdk.version>
        <pixivdownload.source.sha>HEAD</pixivdownload.source.sha>
        <flatten.maven.version>1.7.3</flatten.maven.version>
        <maven.gpg.version>3.2.8</maven.gpg.version>
        <central.publishing.version>0.11.0</central.publishing.version>
        <!-- 源码与 fork 构建默认不启用官方调查；官方发布 profile 只翻转这些激活位。 -->
        <layout-survey.official-release-enabled>false</layout-survey.official-release-enabled>
        <multi-mode-decision-survey.official-release-enabled>false</multi-mode-decision-survey.official-release-enabled>
        <powershell.executable>pwsh</powershell.executable>
        <jacoco.version>0.8.12</jacoco.version>
        <jna.version>5.17.0</jna.version>
        <pf4j.version>3.12.0</pf4j.version>
        <proguard.version>7.10.0</proguard.version>
        <project.build.outputTimestamp>2000-01-01T00:00:00Z</project.build.outputTimestamp>
        <pixivdownload.proguard.skip>true</pixivdownload.proguard.skip>
        <pixivdownload.proguard.additionalProgramPath>${project.build.directory}/proguard/additional-program</pixivdownload.proguard.additionalProgramPath>
        <pixivdownload.proguard.libraryExcludeArtifactIds>mybatis-spring-boot-starter</pixivdownload.proguard.libraryExcludeArtifactIds>
        <pixivdownload.proguard.outputDirectory>${project.build.directory}/proguard/classes</pixivdownload.proguard.outputDirectory>
        <pixivdownload.jar.classesDirectory>${project.build.outputDirectory}</pixivdownload.jar.classesDirectory>
        <!-- jacoco prepare-agent 会覆写该属性注入 agent；无 jacoco 的模块则解析为空串 -->
        <argLine></argLine>
    </properties>

    <!--
      跨模块版本收口：PF4J 是插件框架运行时（外置插件目录定位 / 加载 / 启动），版本在此集中管理，
      由 pixivdownload-plugin-runtime 承载、随 boot jar 装入；slf4j-api / spring 等其余坐标仍由
      spring-boot-starter-parent 的 dependencyManagement 统一管理。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.sywyar.pixivdownloader</groupId>
                <artifactId>pixivdownload-sdk-info</artifactId>
                <version>${pixivdownload.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.sywyar.pixivdownloader</groupId>
                <artifactId>pixivdownload-plugin-api</artifactId>
                <version>${pixivdownload.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.sywyar.pixivdownloader</groupId>
                <artifactId>pixivdownload-core-api</artifactId>
                <version>${pixivdownload.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>org.pf4j</groupId>
                <artifactId>pf4j</artifactId>
                <version>${pf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten.maven.version}</version>
                    <configuration>
                        <flattenedPomFilename>${project.build.directory}/flattened-pom.xml</flattenedPomFilename>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>proguard-library-classpath</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <skip>${pixivdownload.proguard.skip}</skip>
                            <includeScope>compile</includeScope>
                            <excludeArtifactIds>${pixivdownload.proguard.libraryExcludeArtifactIds}</excludeArtifactIds>
                            <outputProperty>pixivdownload.proguard.libraryClasspath</outputProperty>
                            <silent>true</silent>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- JDK 23+ 默认禁用隐式注解处理（Lombok 等处理器不再经 classpath 自动发现），
                显式声明 Lombok 处理器路径，使任意 JDK（17/21/23/26…）下 @RequiredArgsConstructor
                等注解都能正常生成代码；未依赖 Lombok 的模块不受影响。 -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.40</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <classesDirectory>${pixivdownload.jar.classesDirectory}</classesDirectory>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-ant</artifactId>
                        <version>${proguard.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>proguard-release-classes</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${pixivdownload.proguard.skip}</skip>
                            <target>
                                <delete dir="${pixivdownload.proguard.outputDirectory}" quiet="true"/>
                                <mkdir dir="${project.build.directory}/proguard/additional-program"/>
                                <mkdir dir="${pixivdownload.proguard.outputDirectory}"/>
                                <mkdir dir="${project.build.directory}/proguard/reports"/>
                                <path id="pixivdownload.proguard.program">
                                    <pathelement path="${pixivdownload.proguard.additionalProgramPath}"/>
                                </path>
                                <path id="pixivdownload.proguard.jmods">
                                    <fileset dir="${java.home}/jmods">
                                        <include name="*.jmod"/>
                                    </fileset>
                                </path>
                                <path id="pixivdownload.proguard.libraries">
                                    <path path="${pixivdownload.proguard.libraryClasspath}"/>
                                </path>
                                <java classname="proguard.ProGuard" fork="true" failonerror="true" maxmemory="2048m">
                                    <classpath refid="maven.plugin.classpath"/>
                                    <arg value="-include"/>
                                    <arg file="${maven.multiModuleProjectDirectory}/build-support/proguard/base.pro"/>
                                    <arg value="-include"/>
                                    <arg file="${maven.multiModuleProjectDirectory}/build-support/proguard/spring.pro"/>
                                    <arg value="-include"/>
                                    <arg file="${maven.multiModuleProjectDirectory}/build-support/proguard/plugin.pro"/>
                                    <arg value="-injars"/>
                                    <arg value="${project.build.outputDirectory}(!**.jar;)"/>
                                    <arg value="-injars"/>
                                    <arg pathref="pixivdownload.proguard.program"/>
                                    <arg value="-outjars"/>
                                    <arg file="${pixivdownload.proguard.outputDirectory}"/>
                                    <arg value="-libraryjars"/>
                                    <arg pathref="pixivdownload.proguard.libraries"/>
                                    <arg value="-libraryjars"/>
                                    <arg pathref="pixivdownload.proguard.jmods"/>
                                    <arg value="-printconfiguration"/>
                                    <arg file="${project.build.directory}/proguard/reports/configuration.pro"/>
                                    <arg value="-printseeds"/>
                                    <arg file="${project.build.directory}/proguard/reports/seeds.txt"/>
                                    <arg value="-printusage"/>
                                    <arg file="${project.build.directory}/proguard/reports/usage.txt"/>
                                </java>
                                <copy todir="${pixivdownload.proguard.outputDirectory}" overwrite="true">
                                    <fileset dir="${project.build.outputDirectory}" erroronmissingdir="false">
                                        <include name="**/*.jar"/>
                                    </fileset>
                                </copy>
                                <mkdir dir="${pixivdownload.proguard.outputDirectory}/META-INF"/>
                                <echo file="${pixivdownload.proguard.outputDirectory}/META-INF/pixivdownload-proguard.properties"
                                      encoding="UTF-8">formatVersion=1
proguard.version=${proguard.version}
shrink=true
optimize=true
obfuscate=false
</echo>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Windows 中文环境下，JDK 17 的 surefire 测试 fork 默认用平台编码（GBK/cp936）写 stdout/stderr，
                而 surefire 按 UTF-8 解码，导致测试输出的中文在控制台与 surefire-reports 中乱码。
                显式让 fork 使用 UTF-8（@{argLine} 延迟替换，保留 jacoco 等插件注入的 argLine）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>sdk-central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.gpg.version}</version>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-sdk-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central.publishing.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>PUBLISHED</waitUntil>
                            <checksums>all</checksums>
                            <deploymentName>PixivDownloader Plugin SDK ${pixivdownload.sdk.version}</deploymentName>
                            <excludeArtifacts>
                                <excludeArtifact>pixivdownload-parent</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>official-surveys</id>
            <properties>
                <layout-survey.official-release-enabled>true</layout-survey.official-release-enabled>
                <multi-mode-decision-survey.official-release-enabled>true</multi-mode-decision-survey.official-release-enabled>
            </properties>
        </profile>
        <profile>
            <id>windows-powershell</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
            </activation>
            <properties>
                <powershell.executable>powershell</powershell.executable>
            </properties>
        </profile>
    </profiles>

</project>
