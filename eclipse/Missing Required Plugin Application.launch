<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.eclipse.jdt.launching.localJavaApplication">
  <booleanAttribute key="org.eclipse.debug.core.ATTR_FORCE_SYSTEM_CONSOLE_ENCODING" value="true" />
  <stringAttribute key="org.eclipse.jdt.launching.MAIN_TYPE" value="top.sywyar.pixivdownload.gui.GuiLauncher" />
  <stringAttribute key="org.eclipse.jdt.launching.PROGRAM_ARGUMENTS" value="--pixivdownload.recovery-sentinel.required=true" />
  <stringAttribute key="org.eclipse.jdt.launching.PROJECT_ATTR" value="PixivDownload" />
  <stringAttribute key="org.eclipse.jdt.launching.WORKING_DIRECTORY" value="${workspace_loc:/PixivDownload}/.." />
</launchConfiguration>
