<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.example.pixivdownload</groupId><artifactId>typed-service-example</artifactId><version>0.1.0</version></parent>
    <artifactId>text-metrics-contract</artifactId>
    <dependencies><dependency><groupId>io.github.sywyar.pixivdownloader</groupId><artifactId>pixivdownload-sdk</artifactId></dependency><dependency><groupId>com.example.pixivdownload</groupId><artifactId>text-metrics-api</artifactId></dependency></dependencies>
    <build><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version>
            <executions><execution><id>original-api</id><phase>prepare-package</phase><goals><goal>copy</goal></goals><configuration>
                <artifactItems><artifactItem><groupId>com.example.pixivdownload</groupId><artifactId>text-metrics-api</artifactId><version>${project.version}</version><type>jar</type><outputDirectory>${project.build.outputDirectory}/lib</outputDirectory><destFileName>text-metrics-api.jar</destFileName></artifactItem></artifactItems>
            </configuration></execution></executions>
        </plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId><version>3.1.0</version>
            <executions><execution><id>bind-api-bytes</id><phase>prepare-package</phase><goals><goal>run</goal></goals><configuration><target>
                <copy file="${project.basedir}/src/main/resources/plugin.properties" tofile="${project.build.outputDirectory}/plugin.properties" overwrite="true"/>
                <checksum file="${project.build.outputDirectory}/lib/text-metrics-api.jar" algorithm="SHA-256" property="contract.sha256"/>
                <echo file="${project.build.outputDirectory}/plugin.properties" append="true" encoding="UTF-8">${line.separator}pixiv.contract-sha256=${contract.sha256}${line.separator}</echo>
            </target></configuration></execution></executions>
        </plugin>
    </plugins></build>
</project>
