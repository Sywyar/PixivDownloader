config/
state/
data/
pixiv-download/
pixiv-download-Enn/
_collection_icons/
collection_icons/
_tts/
_gui/
log/
update-cache/
test/
test-data/

# 版本管理 / IDE
.git/
.gitignore
.idea/
.vscode/
.settings/

# 文档与本地说明（构建不需要）
docs/
*.md
LICENSE
