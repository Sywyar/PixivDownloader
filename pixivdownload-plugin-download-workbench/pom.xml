<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>top.sywyar.lovepopup</groupId>
        <artifactId>pixivdownload-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>pixivdownload-plugin-download-workbench</artifactId>
    <name>PixivDownloader Download Workbench Plugin</name>
    <description>Official required external PF4J plugin for the download workbench, Pixiv fetch proxy, queue, userscripts, and scheduled download host.</description>

    <properties>
        <!--
            布局偏好调查（PostHog API Survey）公开客户端配置。
            默认全部留空：普通源码构建与普通 fork 构建生成 enabled=false，不连接 PostHog。
            官方发行构建经 GitHub Actions Repository Variables 注入四项（vars 上下文，不是 secrets）；
            部分提供时构建失败并列出缺失字段。posthog-js 是程序依赖，锁定精确版本，不允许部署变量覆盖。
        -->
        <pixiv.layout-survey.project-token></pixiv.layout-survey.project-token>
        <pixiv.layout-survey.survey-id></pixiv.layout-survey.survey-id>
        <pixiv.layout-survey.api-host></pixiv.layout-survey.api-host>
        <pixiv.layout-survey.ui-host></pixiv.layout-survey.ui-host>
        <pixiv.layout-survey.require-config>false</pixiv.layout-survey.require-config>
        <posthog-js.version>1.409.5</posthog-js.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>top.sywyar.lovepopup</groupId>
            <artifactId>pixivdownload-plugin-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>top.sywyar.lovepopup</groupId>
            <artifactId>pixivdownload-core-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>top.sywyar.lovepopup</groupId>
            <artifactId>pixivdownload-plugin-runtime</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.40</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-bundled-userscript</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>${powershell.executable}</executable>
                            <arguments>
                                <argument>-NoProfile</argument>
                                <argument>-NonInteractive</argument>
                                <argument>-Command</argument>
                                <argument>&amp; '${maven.multiModuleProjectDirectory}/scripts/build-userscript-bundle.ps1' -Version '${app.release.version}'</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-layout-survey-public-config</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>${powershell.executable}</executable>
                            <arguments>
                                <argument>-NoProfile</argument>
                                <argument>-NonInteractive</argument>
                                <argument>-File</argument>
                                <argument>${maven.multiModuleProjectDirectory}/scripts/generate-layout-survey-public-config.ps1</argument>
                            </arguments>
                            <environmentVariables>
                                <PIXIV_LAYOUT_SURVEY_PROJECT_TOKEN>${pixiv.layout-survey.project-token}</PIXIV_LAYOUT_SURVEY_PROJECT_TOKEN>
                                <PIXIV_LAYOUT_SURVEY_ID>${pixiv.layout-survey.survey-id}</PIXIV_LAYOUT_SURVEY_ID>
                                <PIXIV_LAYOUT_SURVEY_API_HOST>${pixiv.layout-survey.api-host}</PIXIV_LAYOUT_SURVEY_API_HOST>
                                <PIXIV_LAYOUT_SURVEY_UI_HOST>${pixiv.layout-survey.ui-host}</PIXIV_LAYOUT_SURVEY_UI_HOST>
                                <PIXIV_LAYOUT_SURVEY_OUTPUT_PATH>${project.build.outputDirectory}/static/pixiv-layout-feedback/public-config.js</PIXIV_LAYOUT_SURVEY_OUTPUT_PATH>
                                <PIXIV_LAYOUT_SURVEY_REQUIRE_CONFIG>${pixiv.layout-survey.require-config}</PIXIV_LAYOUT_SURVEY_REQUIRE_CONFIG>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-userscripts</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static/userscripts</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}</directory>
                                    <includes>
                                        <include>*.user.js</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}/build/generated-userscripts</directory>
                                    <includes>
                                        <include>*.user.js</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
