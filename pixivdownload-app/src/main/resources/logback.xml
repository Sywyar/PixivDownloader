<configuration>
    <define name="LOG_TIMESTAMP" class="top.sywyar.pixivdownload.logback.LogSession"/>
    <conversionRule conversionWord="mdcColor"
                    class="top.sywyar.pixivdownload.logback.MdcColorConverter"/>

    <property name="console_pattern"
              value="%d{HH:mm:ss.SSS} %mdcColor(%-5level) %cyan([%thread]) %blue(%logger{36}) - %mdcColor(%msg) %n"/>
    <property name="file_pattern"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %replace(%msg){'\x1B\[[0-9;:]*m',''}%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${console_pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE_LATEST" class="top.sywyar.pixivdownload.logback.SessionFileAppender">
        <file>${LOG_DIRECTORY}/latest.log</file>
        <append>false</append>
        <encoder>
            <pattern>${file_pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE_SESSION" class="top.sywyar.pixivdownload.logback.SessionFileAppender">
        <file>${LOG_DIRECTORY}/pixiv-download_${LOG_TIMESTAMP}.log</file>
        <append>false</append>
        <encoder>
            <pattern>${file_pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="HTML_LATEST" class="top.sywyar.pixivdownload.logback.SessionFileAppender">
        <file>${LOG_DIRECTORY}/html/latest.html</file>
        <append>false</append>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="top.sywyar.pixivdownload.logback.HtmlLogLayout"/>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="HTML_SESSION" class="top.sywyar.pixivdownload.logback.SessionFileAppender">
        <file>${LOG_DIRECTORY}/html/pixiv-download_${LOG_TIMESTAMP}.html</file>
        <append>false</append>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="top.sywyar.pixivdownload.logback.HtmlLogLayout"/>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="FILE_LATEST"/>
        <appender-ref ref="FILE_SESSION"/>
        <appender-ref ref="HTML_LATEST"/>
        <appender-ref ref="HTML_SESSION"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
