#!/usr/bin/env bash
# Local pre-push guard. Orchestrates the shared gates in order:
#   1. existing signature guard (pre-push-guard.sh)
#   2. full i18n check
#   3. (future shared gates are appended here)
# Activate with:  git config core.hooksPath scripts/hooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

bash "$root/scripts/hooks/pre-push-guard.sh"

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    echo "pre-push: node/npm are required for the i18n gate but were not found in PATH." >&2
    echo "pre-push: install Node.js (see docs/i18n-workflow.md) and re-run the push." >&2
    exit 1
fi

npm run i18n:check
